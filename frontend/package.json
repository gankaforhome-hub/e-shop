{
  "name": "frontend",
  "version": "0.1.0",
  "description": "gankaforhome frontend",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/gankaforhome/gankaforhome.git"
  },
  "author": "Maksym Holovachuk <m.holovachuk@gmail.com>",
  "keywords": [
    "react",
    "next",
    "web",
    "tailwindcss"
  ],
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "open-cli http://localhost:3000 && next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check-types": "tsc --pretty --noEmit",
    "check-lint": "eslint . --ext ts --ext tsx --ext js --report-unused-disable-directives --max-warnings 0",
    "prettier": "prettier --write .",
    "check-format": "prettier --check .",
    "fix": "pnpm run prettier && pnpm run lint --fix",
    "test-all": "pnpm run check-format && pnpm run check-lint && pnpm run check-types && pnpm run build",
    "test": "",
    "commit": "cz",
    "build:icons": "pnpx tsx ./build-icons.mts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.1",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-fade": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.16.0",
    "lucide-react": "^1.24.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-div-100vh": "^0.7.0",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.56.4",
    "react-responsive": "^10.0.1",
    "tailwind-merge": "^3.2.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.42"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/eslint-plugin-next": "^15.3.1",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.31.0",
    "@typescript-eslint/parser": "^8.31.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "eslint-config-prettier": "^10.1.2",
    "eslint-import-resolver-typescript": "^4.3.4",
    "eslint-plugin-boundaries": "^5.0.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-next": "^0.0.0",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-storybook": "^0.12.0",
    "eslint-plugin-tailwind": "^0.2.1",
    "fs-extra": "^11.3.0",
    "glob": "^11.0.2",
    "node-html-parser": "^7.0.1",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.2.8",
    "typescript": "^5"
  },
  "devEngines": {
    "node": ">=22.14.0"
  }
}
