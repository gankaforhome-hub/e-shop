# Public site URL (metadata, canonical, hreflang)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Pre-launch noindex until "true"
ALLOW_INDEXING=false

# Backend API base URL, server-side only (never NEXT_PUBLIC). Run `pnpm bdev` for it.
API_URL=http://127.0.0.1:3001/api
# Host of the public Supabase Storage bucket the API returns media URLs for
# (hostname only, e.g. [PROJECT_REF].supabase.co). Used by next/image remotePatterns.
MEDIA_PUBLIC_HOST=
 
# Shared secret for POST /api/revalidate (the backend sends it in x-revalidate-secret).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
REVALIDATE_SECRET=

# Cloudflare Turnstile site key for the sign-up and forgot-password forms. Empty: no widget.
# The backend needs the matching TURNSTILE_SECRET_KEY. Test pair (always passes):
# site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Google sign-in: the same OAuth client id as the backend (no secret here). Empty: no Google button.
# Google Console > Authorized redirect URI: <NEXT_PUBLIC_SITE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
