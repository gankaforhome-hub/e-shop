# Public site URL (metadata, canonical, hreflang)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Pre-launch noindex until "true"
ALLOW_INDEXING=false

# Backend API base URL, server-side only (never NEXT_PUBLIC). Run `pnpm bdev` for it.
API_URL=http://127.0.0.1:3001/api
# Host of the public Supabase Storage bucket the API returns media URLs for
# (hostname only, e.g. [PROJECT_REF].supabase.co). Used by next/image remotePatterns.
MEDIA_PUBLIC_HOST=
 
# Shared secret for POST /api/revalidate (the backend sends it in x-revalidate-secret).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
REVALIDATE_SECRET=
