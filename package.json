{
  "name": "gankaforhome",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
  "workspaces": [
    "frontend",
    "backend",
    "cms"
  ],
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "test": "echo \"Error: no test specified\" && exit 1",
    "fdev": "pnpm --filter frontend run dev",
    "fstart": "pnpm --filter frontend run start",
    "fbuild": "pnpm --filter frontend run build",
    "flint": "pnpm --filter frontend lint",
    "blint": "pnpm --filter cms lint",
    "clint": "pnpm --filter backend lint",
    "prepare": "husky install",
    "commitlint": "commitlint --edit ",
    "commit": "cz",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@commitlint/types": "^19.8.0",
    "commitizen": "^4.3.1",
    "cz-customizable": "^7.4.0",
    "husky": "^8.0.0",
    "lint-staged": "^15.5.1",
    "open-cli": "^8.0.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "devEngines": {
    "node": ">=22.14.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": ".cz-config.js"
    }
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "pnpm run --filter frontend lint --file",
      "pnpm run --filter frontend prettier --write"
    ]
  }
}
