{
  "name": "gankaforhome",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "test": "echo \"Error: no test specified\" && exit 1",
    "fdev": "pnpm --filter frontend run dev",
    "fstart": "pnpm --filter frontend run start",
    "fbuild": "pnpm --filter frontend run build",
    "flint": "pnpm --filter frontend lint",
    "cdev": "pnpm --filter cms run dev",
    "cstart": "pnpm --filter cms run start",
    "cbuild": "pnpm --filter cms run build",
    "clint": "pnpm --filter cms lint",
    "bdev": "pnpm --filter backend run dev",
    "bstart": "pnpm --filter backend run start:prod",
    "bbuild": "pnpm --filter backend run build",
    "blint": "pnpm --filter backend lint",
    "docker:start": "docker compose up -d --build",
    "docker:dev": "docker compose -f compose.yaml -f compose.dev.yaml up --build --watch",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "check-types": "pnpm -r check-types",
    "prepare": "husky install",
    "commitlint": "commitlint --edit ",
    "commit": "cz",
    "format": "prettier --write .",
    "shadcn:add": "node scripts/shadcn-add.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@commitlint/types": "^19.8.0",
    "commitizen": "^4.3.1",
    "cz-customizable": "^7.4.0",
    "husky": "^8.0.0",
    "lint-staged": "^15.5.1",
    "open-cli": "^8.0.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.14.0"
    }
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": ".cz-config.js"
    }
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "pnpm run --filter frontend lint --file",
      "pnpm run --filter frontend prettier --write"
    ]
  }
}
