{
  "name": "gankaforhome",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.9.0",
  "workspaces": [
    "frontend",
    "backend",
    "cms"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "fdev": "pnpm --filter frontend run dev",
    "fbuild": "pnpm --filter frontend run build",
    "flint": "pnpm --filter frontend lint",
    "blint": "pnpm --filter cms lint",
    "clint": "pnpm --filter backend lint",
    "prepare": "husky install",
    "commitlint": "commitlint --edit ",
    "commit": "cz"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@commitlint/types": "^19.8.0",
    "commitizen": "^4.3.1",
    "cz-customizable": "^7.4.0",
    "husky": "^8.0.0",
    "lint-staged": "^15.5.1",
    "open-cli": "^8.0.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "devEngines": {
    "node": ">=22.14.0",
    "packageManager": {
      "name": "pnpm",
      "version": "10.9.0+sha512.0486e394640d3c1fb3c9d43d49cf92879ff74f8516959c235308f5a8f62e2e19528a65cdc2a3058f587cde71eba3d5b56327c8c33a97e4c4051ca48a10ca2d5f"
    }
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": ".cz-config.js"
    }
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "pnpm run --filter frontend lint --file",
      "pnpm run --filter frontend prettier --write"
    ]
  }
}
