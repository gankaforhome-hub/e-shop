# Copy to backend/.env for local work. On Render every value goes into the dashboard
# (render.yaml lists them, secrets are `sync: false`); in Docker pass them with `env_file`.
# Each environment (local, Docker, production) has its own database, bucket and ROOT_* values:
# never copy ids or secrets between them.
#
# Required to start: DATABASE_URL, JWT_SECRET, JWT_*_EXP, SUPABASE_URL, SUPABASE_SECRET_KEY,
# MEDIA_BUCKET. Required in production on top: FRONTEND_URL, CMS_ORIGINS, RESEND_API_KEY,
# MAIL_FROM, WEBAUTHN_* for the real domain, ROOT_USER_IDS for a working root.

# development | test | production. Production turns on the strict checks (origins, mail).
NODE_ENV=development
# Local default 3001 (the CMS calls http://localhost:3001/api). Render: 10000 (render.yaml).
SERVER_PORT=3001

# Required, at least 32 characters. The API does not start without it. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Units: s, m, h, d
JWT_ACCESS_TOKEN_EXP=15m
# Units: s, m, h, d, M (months), y
JWT_REFRESH_TOKEN_EXP=1M

# Number of reverse proxies in front of the API (0 when it is reached directly).
# Rate limiting uses the client IP, so a wrong value limits the proxy or trusts spoofed headers.
# Local: 0. Render: 1 (its load balancer). Docker behind Caddy/nginx: 1.
TRUST_PROXY_HOPS=0

# Base URLs for links in emails.
# FRONTEND_URL: the storefront (customer mails: welcome/confirm email, password reset). Required
#   in production.
# CMS_URL: the CMS (staff mails: invitation, password reset of a staff account; also printed by
#   admin:bootstrap-root). Unset: FRONTEND_URL is used.
FRONTEND_URL=http://localhost:3000
CMS_URL=http://localhost:3030

# Cloudflare Turnstile (bot check on sign-up and forgot-password). Empty: off.
# The storefront needs the matching NEXT_PUBLIC_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET_KEY=

# Storefront Google sign-in (Google Cloud Console > APIs & Services > Credentials > OAuth client,
# type "Web application"). Authorized redirect URI: <storefront>/api/auth/google/callback.
# Both empty: Google sign-in is off (POST /auth/google answers 404). The storefront needs the
# same GOOGLE_CLIENT_ID. An account with the same email is merged (Google wins, see AGENTS.md §2).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated origins allowed to use each kind of session.
# Empty: the check is skipped outside production and every request is refused in production.
# Exact origins: scheme + host (+ port), no path or trailing slash.
# Local: CMS_ORIGINS=http://localhost:3030  STOREFRONT_ORIGINS=http://localhost:3000
# Production: CMS_ORIGINS=https://cms.example.com  STOREFRONT_ORIGINS=https://example.com,https://www.example.com
CMS_ORIGINS=
STOREFRONT_ORIGINS=

# Root admin. Root rights need ALL of: role ROOT in the database, the user id in ROOT_USER_IDS,
# and a session confirmed with a key whose id is in ROOT_CREDENTIAL_IDS. So write access to the
# database alone can't create a root or slip in a key. Restart the API after a change.
# `pnpm --filter backend admin:bootstrap-root <email>` (run against this environment's database)
# prints the user id and a fresh ROOT_ENROLLMENT_CODE.
# ROOT_USER_IDS: comma-separated UUIDs, e.g. 3f2b6c1e-8a4d-4f7e-9b1a-2c5d7e9f0a11
# ROOT_ENROLLMENT_CODE: at least 32 characters; lets a root without any key add the first one.
#   Clear it once the keys are registered. Empty: no root can enroll a key.
# ROOT_CREDENTIAL_IDS: comma-separated key ids (base64url) the CMS shows after adding a root key
#   (the first one and the spare one).
# Values of another database mean nothing here; empty ROOT_USER_IDS: no root (admins still work).
ROOT_USER_IDS=
ROOT_ENROLLMENT_CODE=
ROOT_CREDENTIAL_IDS=

# Hardware keys. The defaults fit local development with the CMS on port 3030.
# WEBAUTHN_RP_ID: the CMS host without scheme or port; keys are bound to it, so changing it
#   later invalidates every key. Production: WEBAUTHN_RP_ID=cms.example.com (or example.com to
#   share keys across subdomains). Locally open the CMS on localhost, not 127.0.0.1.
# WEBAUTHN_ORIGINS: comma-separated full origins of the CMS, e.g. https://cms.example.com
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Ganka CMS
WEBAUTHN_ORIGINS=http://localhost:3030

# Media storage (Supabase Storage). Required, the API does not start without them.
# SUPABASE_URL: Project Settings > Data API > Project URL, https://[PROJECT_REF].supabase.co
#   (not the S3 endpoint .../storage/v1/s3; S3 access keys aren't used).
# SUPABASE_SECRET_KEY: Project Settings > API Keys > Secret keys (sb_secret_...). Backend only.
# MEDIA_BUCKET: a public bucket (5 MB, image/webp). media-dev for development, so a local
#   reset never touches production files.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
MEDIA_BUCKET=

# Development only. Password of the test accounts from prisma/seed-data/users.ts
# (8 characters to 72 bytes). Empty: `pnpm --filter backend prisma:seed` skips the accounts.
SEED_USER_PASSWORD=

# Database. Pick ONE option. The API always reads DATABASE_URL;
# the Prisma CLI (migrations, Studio) reads DIRECT_URL and falls back to DATABASE_URL.

# Option 1: local PostgreSQL (`pnpm --filter backend docker:up`). Inside Docker Compose the host
# is the database service name instead of localhost, e.g. @postgres:5432.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/db_admin"

# Option 2: Supabase (Postgres only, authentication stays in NestJS)
# Values: Supabase Dashboard > Connect.
# Transaction pooler, for the API. uselibpqcompat makes pg treat sslmode=require as
# "encrypt without verifying the CA", which Supabase's own certificate chain needs.
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?uselibpqcompat=true&sslmode=require"
# Session pooler, for migrations (they can't run through the transaction pooler).
# DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# Storefront cache revalidation after CMS changes. Both optional: without them the backend skips it.
# FRONTEND_REVALIDATE_URL: full URL of the storefront route, e.g. http://localhost:3000/api/revalidate
# REVALIDATE_SECRET: the same value as in frontend/.env
FRONTEND_REVALIDATE_URL=
REVALIDATE_SECRET=

# Mail (Resend). Empty RESEND_API_KEY: emails are printed to the `pnpm bdev` console; the API refuses
# to start without it in production. With a key, every email is really sent, also in development.
# RESEND_API_KEY: Resend dashboard > API Keys (sending access is enough).
# MAIL_FROM: required with the key. Its domain must be verified in Resend; until then only
#   "Ganka for Home <onboarding@resend.dev>" works, and only to the Resend account owner's address.
#   Later: MAIL_FROM="Ganka for Home <noreply@example.com>" (Resend > Domains > Add domain, DNS records).
RESEND_API_KEY=
MAIL_FROM=
