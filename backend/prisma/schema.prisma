// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//! TYPES
enum E_AuthAudience {
  STOREFRONT
  CMS

  @@map("auth_audience")
}

enum E_OneTimeTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE_OLD
  EMAIL_CHANGE_NEW
  STAFF_ENROLLMENT

  @@map("one_time_token_purpose")
}

enum E_StaffRole {
  ROOT
  ADMIN
  CONTENT_EDITOR
  CATALOG_MANAGER
  ORDER_MANAGER

  @@map("staff_role")
}

enum E_WebAuthnChallengePurpose {
  REGISTRATION
  LOGIN
  ASSERTION

  @@map("webauthn_challenge_purpose")
}

enum E_Locale {
  uk
  en

  @@map("locale")
}

