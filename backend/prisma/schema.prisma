//! MODELS
model User {
  id                  String               @id @default(uuid())
  email               String               @unique @db.VarChar()
  password            String?              @db.VarChar()
  name                String?              @db.VarChar(100)
  emailVerifiedAt     DateTime?            @map("email_verified_at") @db.Timestamptz()
  // status    E_UserStatus[] @default([ACTIVE])
  // isActivated Boolean?    @default(false) @map("is_activated")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz()
  token               Token[]
  oneTimeTokens       OneTimeToken[]
  staffAccount        StaffAccount?
  webAuthnCredentials WebAuthnCredential[]
  webAuthnChallenges  WebAuthnChallenge[]

  @@map("users")
}

model Token {
  id           String         @id @default(uuid())
  // SHA-256 of the refresh token; the raw value lives only in the cookie
  token        String         @unique
  // All rotations of one sign-in share a family, revoked together on reuse
  familyId     String         @map("family_id")
  audience     E_AuthAudience @default(STOREFRONT)
  aal          Int            @default(1)
  // The key that raised this session to aal 2
  credentialId String?        @map("credential_id")
  expires      DateTime       @db.Timestamptz()
  rotatedAt    DateTime?      @map("rotated_at") @db.Timestamptz()
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  userAgent    String?        @map("user_agent")
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String         @map("user_id")

  @@index([userId])
  @@index([familyId])
  @@map("tokens")
}

model OneTimeToken {
  // SHA-256 of the token; the raw value is only sent to the user
  hash       String                @id
  purpose    E_OneTimeTokenPurpose
  // The requested address, for EMAIL_CHANGE_* tokens only
  newEmail   String?               @map("new_email") @db.VarChar()
  expires    DateTime              @db.Timestamptz()
  consumedAt DateTime?             @map("consumed_at") @db.Timestamptz()
  createdAt  DateTime              @default(now()) @map("created_at") @db.Timestamptz()
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String                @map("user_id")

  @@index([userId])
  @@map("one_time_tokens")
}

// No row means a customer. Only the CLI can create a ROOT row, no HTTP route can
model StaffAccount {
  userId       String      @id @map("user_id")
  role         E_StaffRole
  approvedAt   DateTime?   @map("approved_at") @db.Timestamptz()
  // No foreign key: AuditLog keeps the history even if that user is gone
  approvedById String?     @map("approved_by_id")
  revokedAt    DateTime?   @map("revoked_at") @db.Timestamptz()
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz()
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("staff_accounts")
}

model WebAuthnCredential {
  // base64url credential id
  id         String    @id
  publicKey  Bytes     @map("public_key")
  counter    BigInt
  deviceType String    @map("device_type") @db.VarChar(32)
  backedUp   Boolean   @map("backed_up")
  transports String[]
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz()
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String    @map("user_id")

  @@index([userId])
  @@map("webauthn_credentials")
}

model WebAuthnChallenge {
  id        String                     @id @default(uuid())
  challenge String
  purpose   E_WebAuthnChallengePurpose
  // For ASSERTION: the one action and target this confirmation may be spent on
  action    String?
  expires   DateTime                   @db.Timestamptz()
  createdAt DateTime                   @default(now()) @map("created_at") @db.Timestamptz()
  user      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String                     @map("user_id")

  @@index([userId])
  @@map("webauthn_challenges")
}

// Append only. Plain ids instead of foreign keys, so the history outlives the users
model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?  @map("actor_id")
  action    String
  targetId  String?  @map("target_id")
  ip        String?
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([actorId])
  @@index([targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

//! CATALOG
// Slug is the key: the frontend filters by it (?season=). CHECK on the format lives in the migration
model Season {
  slug         String              @id @db.VarChar(50)
  sortOrder    Int                 @default(0) @map("sort_order")
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz()
  translations SeasonTranslation[]
  collections  Collection[]

  @@map("seasons")
}

model SeasonTranslation {
  seasonSlug   String   @map("season_slug") @db.VarChar(50)
  languageCode E_Locale @map("language_code")
  label        String   @db.VarChar(50)
  season       Season   @relation(fields: [seasonSlug], references: [slug], onDelete: Cascade, onUpdate: Cascade)

  @@id([seasonSlug, languageCode])
  @@map("season_translations")
}

// Kebab-case slug CHECK lives in the migration. New rows stay hidden until isActive is set
model Collection {
  id           String                  @id @default(uuid())
  slug         String                  @unique @db.VarChar(100)
  sortOrder    Int                     @default(0) @map("sort_order")
  isActive     Boolean                 @default(false) @map("is_active")
  // Three digits in creation order (001, 002, …) from a sequence that never reuses a number.
  // CHECK (three digits) and the sequence live in the migrations
  skuPrefix    String                  @unique @default(dbgenerated("lpad((nextval('collection_sku_prefix_seq'::regclass))::text, 3, '0'::text)")) @map("sku_prefix") @db.VarChar(3)
  seasonSlug   String?                 @map("season_slug") @db.VarChar(50)
  // Media in use can't be deleted (Restrict), the API answers 409
  // Card image, close to square
  coverImageId String?                 @map("cover_image_id")
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime                @updatedAt @map("updated_at") @db.Timestamptz()
  season       Season?                 @relation(fields: [seasonSlug], references: [slug], onDelete: SetNull, onUpdate: Cascade)
  coverImage   Media?                  @relation("CollectionCover", fields: [coverImageId], references: [id], onDelete: Restrict)
  translations CollectionTranslation[]
  // Home hero slides that link here; a linked collection can't be deleted (Restrict)
  banners      Banner[]

  @@index([isActive, sortOrder])
  @@map("collections")
}

// SEO is 1:1 per language, so it sits here; the API falls back to title / shortDescription
model CollectionTranslation {
  collectionId     String     @map("collection_id")
  languageCode     E_Locale   @map("language_code")
  title            String     @db.VarChar(150)
  shortDescription String     @map("short_description") @db.Text
  description      String     @db.Text
  metaTitle        String?    @map("meta_title") @db.VarChar(120)
  metaDescription  String?    @map("meta_description") @db.VarChar(320)
  collection       Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([collectionId, languageCode])
  @@map("collection_translations")
}

// Where a home hero slide leads
enum E_BannerLinkType {
  COLLECTION
  URL

  @@map("banner_link_type")
}

// A home hero slide, independent of collections: own image, texts, link, order and optional
// schedule. CHECKs in the migration: the link matches linkType, endsAt > startsAt, url shape
model Banner {
  id           String              @id @default(uuid())
  linkType     E_BannerLinkType    @map("link_type")
  // COLLECTION: the collection; its title is the fallback when the slide has none
  collectionId String?             @map("collection_id")
  // URL: an internal path (/products) or an https:// link
  url          String?             @db.VarChar(500)
  // Wide 16:9 image; media in use can't be deleted (Restrict)
  imageId      String              @map("image_id")
  isActive     Boolean             @default(false) @map("is_active")
  // Hero order, ascending; a new slide goes last
  sortOrder    Int                 @default(0) @map("sort_order")
  // Optional schedule: no date, no limit
  startsAt     DateTime?           @map("starts_at") @db.Timestamptz()
  endsAt       DateTime?           @map("ends_at") @db.Timestamptz()
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz()
  collection   Collection?         @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  image        Media               @relation(fields: [imageId], references: [id], onDelete: Restrict)
  translations BannerTranslation[]

  @@index([isActive, sortOrder])
  @@index([collectionId])
  @@map("banners")
}

// Texts of a slide per language; every field optional (fallbacks in the API)
model BannerTranslation {
  bannerId     String   @map("banner_id")
  languageCode E_Locale @map("language_code")
  // Empty for a collection slide: the collection title is used
  title        String?  @db.VarChar(150)
  // Line above the title, e.g. "нова колекція"
  subtitle     String?  @db.VarChar(80)
  // Button text; empty: the storefront's default for the link type
  ctaLabel     String?  @map("cta_label") @db.VarChar(40)
  banner       Banner   @relation(fields: [bannerId], references: [id], onDelete: Cascade)

  @@id([bannerId, languageCode])
  @@map("banner_translations")
}

// One uploaded image, stored as WebP variants under media/<checksum>/<width>.webp
model Media {
  id           String       @id @default(uuid())
  // SHA-256 of the original file, so a repeated upload reuses the row
  checksum     String       @unique @db.VarChar(64)
  // width, height and sizeBytes describe the largest variant
  width        Int
  height       Int
  sizeBytes    Int          @map("size_bytes")
  // [{ width, height, size, key }]
  variants     Json
  blurDataUrl  String?      @map("blur_data_url")
  alt          String?      @db.VarChar(250)
  originalName String?      @map("original_name") @db.VarChar(255)
  // Focal point for CSS object-position, 0..1 (CHECK in the migration)
  focalX       Float        @default(0.5) @map("focal_x")
  focalY       Float        @default(0.5) @map("focal_y")
  // { x, y, width, height } as 0..1 fractions of the original; the DTO checks the shape
  cropData     Json?        @map("crop_data")
  // No foreign key, as in AuditLog
  uploadedById String?      @map("uploaded_by_id")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz()
  coverFor     Collection[] @relation("CollectionCover")
  bannerFor    Banner[]

  @@map("media")
}

